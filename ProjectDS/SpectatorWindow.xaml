<!--Окно зрителя: показывает мир и лог, подключаясь к локальному серверу снапшотов.-->
<Window x:Class="ProjectDS.SpectatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spectator" Width="900" Height="600"
        Background="#0B1020">
    <!--Корневой контейнер: снизу статус, в центре мир и панель.-->
    <DockPanel LastChildFill="True">
        <!--Строка состояния: подключение и инфо/ошибки.-->
        <StatusBar DockPanel.Dock="Bottom" Background="#111" Foreground="White">
            <!--Статус подключения.-->
            <StatusBarItem>
                <TextBlock x:Name="TxtConn" Text="disconnected"/>
            </StatusBarItem>
            <!--Разделитель.-->
            <Separator/>
            <!--Информационные сообщения и ошибки.-->
            <StatusBarItem>
                <TextBlock x:Name="TxtInfo" Text=""/>
            </StatusBarItem>
        </StatusBar>
        <!--Основной контент: мир слева, панель справа.-->
        <Grid>
            <!--Колонки: мир шире, панель уже.-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <!--Область мира: Canvas для отрисовки планеты и кораблей.-->
            <Border Grid.Column="0" Background="#0B1020" BorderBrush="#223" BorderThickness="1">
                <!--Canvas мира: зритель не кликает, только смотрит.-->
                <Canvas x:Name="WorldCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#0B1020"/>
            </Border>
            <!--Правая панель: информация и лог.-->
            <DockPanel Grid.Column="1" Background="#111" LastChildFill="True">
                <!--Верхняя часть панели: текстовая информация.-->
                <StackPanel DockPanel.Dock="Top" Margin="10">
                    <!--Заголовок окна зрителя.-->
                    <TextBlock Text="Spectator" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <!--Текущая система и планета.-->
                    <TextBlock x:Name="TxtSystem" Foreground="White" FontSize="14"/>
                    <!--Счёт и ход.-->
                    <TextBlock x:Name="TxtScore" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                    <!--Состояние игрока.-->
                    <TextBlock x:Name="TxtPlayer" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <!--Блок лога: скролл и текст.-->
                <Border Margin="10" BorderBrush="#333" BorderThickness="1" Padding="8">
                    <!--Скролл для лога.-->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!--Текст лога.-->
                        <TextBlock x:Name="TxtLog" Foreground="#DDD" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

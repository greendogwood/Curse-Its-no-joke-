<!--Главное окно игры: меню, панель управления, статус, мир на Canvas и оверлей главного меню.-->
<Window x:Class="ProjectDS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Sim" MinWidth="900" MinHeight="600"
        Width="1100" Height="700"
        Background="#0B1020"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--Корневой контейнер: сверху меню и тулбар, снизу статус, в центре основной контент.-->
    <DockPanel LastChildFill="True">
        <!--Верхнее меню приложения.-->
        <Menu DockPanel.Dock="Top" Background="#111" Foreground="White">
            <!--Раздел меню "Игра".-->
            <MenuItem Header="_Игра">
                <!--Запуск раннера.-->
                <MenuItem Header="_Запуск" Click="BtnRun_Click"/>
                <!--Пауза раннера.-->
                <MenuItem Header="_Пауза" Click="BtnPause_Click"/>
                <!--Один шаг (тик) игры.-->
                <MenuItem Header="_Шаг" Click="BtnStep_Click"/>
                <!--Разделитель.-->
                <Separator/>
                <!--Рестарт игры.-->
                <MenuItem Header="_Рестарт" Click="BtnRestart_Click"/>
                <!--Разделитель.-->
                <Separator/>
                <!--Выход из приложения.-->
                <MenuItem Header="В_ыход" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>
        <!--Панель быстрых кнопок.-->
        <ToolBarTray DockPanel.Dock="Top" Background="#111">
            <!--Тулбар управления игрой.-->
            <ToolBar>
                <!--Кнопка запуска.-->
                <Button x:Name="BtnRun" Content="Запуск" Click="BtnRun_Click"/>
                <!--Кнопка паузы.-->
                <Button x:Name="BtnPause" Content="Пауза" Click="BtnPause_Click"/>
                <!--Кнопка шага.-->
                <Button x:Name="BtnStep" Content="Шаг" Click="BtnStep_Click"/>
                <!--Кнопка рестарта.-->
                <Button x:Name="BtnRestart" Content="Рестарт" Click="BtnRestart_Click"/>
                <!--Разделитель.-->
                <Separator/>
                <!--Кнопка атаки игрока.-->
                <Button x:Name="BtnAttack" Content="Атака (Space)" Click="BtnAttack_Click"/>
                <!--Разделитель.-->
                <Separator/>
                <!--Открыть окно зрителя.-->
                <Button x:Name="BtnOpenSpectator" Content="Зритель" Click="BtnOpenSpectator_Click"/>
            </ToolBar>
        </ToolBarTray>
        <!--Строка состояния: система, счёт, состояние игрока.-->
        <StatusBar DockPanel.Dock="Bottom" Background="#111" Foreground="White">
            <!--Текущая система и планета.-->
            <StatusBarItem>
                <TextBlock Text="{Binding ElementName=TxtSystem, Path=Text}"/>
            </StatusBarItem>
            <!--Разделитель.-->
            <Separator/>
            <!--Счёт и ход.-->
            <StatusBarItem>
                <TextBlock Text="{Binding ElementName=TxtScore, Path=Text}"/>
            </StatusBarItem>
            <!--Разделитель.-->
            <Separator/>
            <!--Состояние игрока.-->
            <StatusBarItem>
                <TextBlock Text="{Binding ElementName=TxtPlayer, Path=Text}"/>
            </StatusBarItem>
        </StatusBar>
        <!--Основной контент: игра и оверлей меню.-->
        <Grid>
            <!--Корень игрового UI: мир слева, панель справа.-->
            <Grid x:Name="GameRoot">
                <!--Колонки: мир шире, панель уже.-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!--Область мира: Canvas для отрисовки планеты, кораблей и линии назначения.-->
                <Border Grid.Column="0" Background="#0B1020" BorderBrush="#223" BorderThickness="1">
                    <!--Canvas мира: принимает клики для задания курса.-->
                    <Canvas x:Name="WorldCanvas"
                            Focusable="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#0B1020"
                            MouseLeftButtonDown="WorldCanvas_MouseLeftButtonDown"/>
                </Border>
                <!--Правая панель: информация, кнопки действий и лог.-->
                <DockPanel Grid.Column="1" Background="#111" LastChildFill="True">
                    <!--Верхняя часть панели: текстовая информация и кнопки.-->
                    <StackPanel DockPanel.Dock="Top" Margin="10">
                        <!--Заголовок блока информации.-->
                        <TextBlock Text="Информация" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                        <!--Текст текущей системы.-->
                        <TextBlock x:Name="TxtSystem" Foreground="White" FontSize="14"/>
                        <!--Текст счёта и хода.-->
                        <TextBlock x:Name="TxtScore" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                        <!--Текст состояния игрока.-->
                        <TextBlock x:Name="TxtPlayer" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
                        <!--Текст выбранной цели.-->
                        <TextBlock x:Name="TxtTarget" Foreground="#DDD" FontSize="13" Margin="0,4,0,0"/>
                        <!--Разделитель между информацией и действиями.-->
                        <Separator Margin="0,10,0,10"/>
                        <!--Заголовок блока действий игрока.-->
                        <TextBlock Text="Действия игрока" Foreground="White" FontSize="14" Margin="0,0,0,6"/>
                        <!--Кнопки действий игрока.-->
                        <WrapPanel>
                            <!--Посадка/взлёт.-->
                            <Button Content="Сесть/Взлететь" Width="130" Margin="0,0,8,8" Click="BtnLandTakeoff_Click"/>
                            <!--Прыжок в другую систему.-->
                            <Button Content="Прыжок" Width="90" Margin="0,0,8,8" Click="BtnJump_Click"/>
                        </WrapPanel>
                        <!--Подсказка по кликам.-->
                        <TextBlock Text="Клик по пустоте: лететь туда. Клик по кораблю: выбрать цель."
                                   Foreground="#AAA" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <!--Подсказка по хоткеям.-->
                        <TextBlock Text="Хоткеи: WASD/стрелки - шаг в сторону + 1 тик. Space - атака ближайшего."
                                   Foreground="#888" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <!--Блок лога: скролл и текст.-->
                    <Border Margin="10" BorderBrush="#333" BorderThickness="1" Padding="8">
                        <!--Скролл для лога.-->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <!--Текст лога.-->
                            <TextBlock x:Name="TxtLog" Foreground="#DDD" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
            <!--Оверлей главного меню: перекрывает игру и блокирует управление.-->
            <Border x:Name="MainMenuOverlay"
                    Background="#CC000000"
                    Visibility="Visible">
                <!--Сетка для центрирования меню.-->
                <Grid>
                    <!--Три строки: верхний отступ, меню, нижний отступ.-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--Контейнер кнопок меню по центру.-->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="360">
                        <!--Название игры.-->
                        <TextBlock Text="SPACE SIM"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18"/>
                        <!--Подзаголовок меню.-->
                        <TextBlock Text="Главное меню"
                                   Foreground="#BBB"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18"/>
                        <!--Кнопка новой игры.-->
                        <Button x:Name="BtnMenuNewGame"
                                Content="Новая игра"
                                Height="44"
                                Margin="0,0,0,10"
                                Click="BtnMenuNewGame_Click"/>
                        <!--Кнопка продолжения.-->
                        <Button x:Name="BtnMenuContinue"
                                Content="Продолжить"
                                Height="44"
                                Margin="0,0,0,10"
                                Click="BtnMenuContinue_Click"/>
                        <!--Кнопка выхода.-->
                        <Button Content="Выход"
                                Height="44"
                                Click="BtnMenuExit_Click"/>
                        <!--Подсказка по Esc.-->
                        <TextBlock Text="Подсказка: Esc - открыть/закрыть меню"
                                   Foreground="#888"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
